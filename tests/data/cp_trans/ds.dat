/com,****************************************************************************
/com,*************************    SOLUTION       ********************************
/com,****************************************************************************
/solu
antype,4                   ! transient analysis
nlgeom,on                  ! Turn on Large Deformation Effects
kbc,1                      ! stepped BC's
_thickRatio=  0     ! Ratio of thick parts in the model
eqsl,sparse,,,,,1
cntr,print,1               ! print out contact info and also make no initial contact an error
trnopt,full,,,,,hht        ! HHT time integration method
tintp, mosp			! Choose transient integration settings for moderate speed application
nlhist,nsol,MAX_TEMP,temp,max
nlhist,nsol,MIN_TEMP,temp,min
